# Required to answer questions through Groq. Create this at console.groq.com.
# GROQ_LLM_API_KEY=
# GROQ_LLM_MODEL_NAME=llama-3.3-70b-versatile
# GENERATE_LLM_MODEL=qwen/qwen3.6-27b
# Optional: defaults to GROQ_LLM_API_KEY when blank.
GENERATE_LLM_Model_API=
ROUTER_LLM_MODEL_NAME=
VISION_MODEL_NAME=

# Required to persist books and chat history. Get these from Supabase project
# settings -> API. Never expose or commit the service-role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
